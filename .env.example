[TEMPLATE]
DATABASE_URL=postgres://trading:trading@localhost:5432/trading
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8080
# Microstructure for the exchange instance: neutral | solidarity (default neutral).
# neutral    = a conventional venue: price-time priority, no mandates, agents decide.
# solidarity = the collective-welfare machinery: giving mandates and need-priority
#              matching for solidarity orders.
MARKET_REGIME=neutral
# Welfare metric for the exchange instance: gini | atkinson | nash (default gini)
WELFARE_METRIC=gini

# The Python agent desk reads Anthropic credentials from the environment or an
# `ant auth login` profile — it is not loaded from this file by the backend.
# ANTHROPIC_API_KEY=
